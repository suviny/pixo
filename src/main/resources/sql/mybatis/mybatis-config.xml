<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE configuration PUBLIC "-//mybatis.org//DTD Config 3.0//EN" "http://mybatis.org/dtd/mybatis-3-config.dtd">
<configuration>
    <!-- SQL 세션 객체 생성시 적용될 마이바티스의 동작 관련 설정 -->
    <settings>
        <!-- 세컨드 레벨 캐시 비활성화 -->
        <setting name="cacheEnabled" value="false"/>
        <!-- 로컬 캐시 적용 범위를 매퍼의 액션(쿼리)단위로 설정 -->
        <setting name="localCacheScope" value="STATEMENT"/>
        <!-- 지연 로딩 비활성화 -->
        <setting name="lazyLoadingEnabled" value="false"/>
        <!-- 컬럼명과 필드명 매핑 활성화 -->
        <setting name="mapUnderscoreToCamelCase" value="true"/>
        <!-- 컬럼의 값이 NULL일 경우, 필드의 'setter()' 또는 Map의 'push()' 호출로 NULL 누락 방지 -->
        <setting name="callSettersOnNulls" value="true"/>
        <!-- INSERT 또는 UPDATE시 NULL값이 포함될 경우 그대로 NULL 사용 -->
        <setting name="jdbcTypeForNull" value="NULL"/>
    </settings>

    <plugins>
        <plugin interceptor="org.siwon.pixo.global.infra.mybatis.interceptor.BaseTimeAuditInterceptor"/>
    </plugins>
</configuration>